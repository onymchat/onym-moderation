# Copy to .env and fill in. Never commit .env or secrets/.

# ─── Deployment ──────────────────────────────────────────────────────
DO_API_KEY=
DOMAIN=onym.app
MODERATION_HOST=moderation-android.onym.app
CADDY_EMAIL=you@example.com
DO_REGION=ams3
DO_DROPLET_SIZE=s-1vcpu-1gb
SSH_KEY_PATH=~/.ssh/id_ed25519

# Written back by deploy.sh once the droplet exists; leave blank.
DROPLET_ID=
DROPLET_IP=

# ─── Interface identity ──────────────────────────────────────────────
# Ed25519 seed for the interface's countersigning key. Generate with:
#   openssl rand -hex 32
# Rotating this invalidates every countersignature already issued, so
# treat it as long-lived and back it up with the store.
MODERATION_INTERFACE_SIGNING_SEED=
MODERATION_INTERFACE_COMPONENT_ID=onym:component:onym-android

# Per-authority countersigning epochs: <componentId>=<epoch>, comma
# separated. An authority not listed is on epoch 0, which is the seed
# above used directly — so leaving this empty is exactly the behaviour
# before per-authority keys existed, and no authority needs reconfiguring.
#
# Bump one authority's epoch to rotate only that relationship. Every
# mandate it countersigned under the old epoch stops verifying, and no
# other authority is affected. Read the new key from /health
# (`rotatedInterfaceKeys`) and give it to them as their
# AUTHORITY_INTERFACE_KEY *before* deploying the bump, or their
# registrations fail in the gap.
#
# MODERATION_INTERFACE_KEY_EPOCHS=onym:component:some-authority=1
MODERATION_INTERFACE_KEY_EPOCHS=

# ─── Google Play Integrity ───────────────────────────────────────────
# The service-account JSON key of the Cloud project linked in the Play
# Console goes at secrets/play-sa.json (not here). The account needs the
# Play Integrity API role, the API must be enabled on the project, and
# the app must be opted into the device recall beta in the Play Console.
#
# The app's package name — used in API URLs and enforced against every
# decoded token.
MODERATION_PLAY_PACKAGE_NAME=app.onym.android
# Accepted signing-certificate SHA-256 digests, comma separated, exactly
# as Google spells them in a decoded token's certificateSha256Digest
# (the Play App Signing certificate for a store build).
MODERATION_PLAY_CERT_SHA256_DIGESTS=
# Freshness window for a token's requestDetails.timestampMillis.
MODERATION_PLAY_TOKEN_MAX_AGE_SECS=600
# Challenge shelf life, seconds. A gate session fetches a challenge,
# folds it into the signed payload and Play's requestHash, and presents
# it once.
MODERATION_CHALLENGE_TTL_SECS=600
# Window in which a read still showing pre-write values after an
# accepted deviceRecall:write is treated as Google's documented (≤30s)
# propagation lag rather than divergence.
MODERATION_PROPAGATION_GRACE_SECS=60

# ─── Trust ───────────────────────────────────────────────────────────
# Reject verdicts whose authority signature does not verify. Defaults
# to false so a deployment can run before authorities publish signing
# keys. MUST be true in production — with it false, anyone who reaches
# the authority endpoint can ban a device.
MODERATION_ENFORCE_SIGNATURES=false

# Bearer token the designated authority presents on POST /v1/verdicts.
# Transport authentication only; the verdict signature is what
# authorizes a mark. REQUIRED: unset, the endpoint refuses everything.
# Generate with: openssl rand -hex 32
MODERATION_AUTHORITY_TOKEN=

# Deliberate opt-out from the line above. Only for a closed test
# deployment — with it true, anyone who reaches the host can submit
# verdicts.
MODERATION_ALLOW_UNAUTHENTICATED_AUTHORITY=false

# Bearer token for GET /v1/write-log, which names every device binding,
# verdict, and mark transition. Unset closes the endpoint.
MODERATION_AUDIT_TOKEN=

# Freshness window for signed session timestamps, seconds. Signatures
# are also single-use, so a captured body cannot be replayed at all.
MODERATION_SESSION_MAX_SKEW_SECS=300

RUST_LOG=info

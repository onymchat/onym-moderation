# Copy to .env and fill in. Never commit .env.

# ─── Deployment ──────────────────────────────────────────────────────
DO_API_KEY=
AUTHORITY_HOST=authority.example.org
CADDY_EMAIL=you@example.org
DO_REGION=ams3
DO_DROPLET_SIZE=s-1vcpu-1gb
SSH_KEY_PATH=~/.ssh/id_ed25519

# Written back by deploy.sh; leave blank.
DROPLET_ID=
DROPLET_IP=

# ─── Identity ────────────────────────────────────────────────────────
# Ed25519 seed for the verdict-signing key: openssl rand -hex 32
#
# Two rules. The manifest's `operator` field must be the matching
# public key, or every verdict this authority issues will be refused
# downstream — the service refuses to start if they disagree.
# And never rotate this while any ban is in force: verdicts already
# issued would stop verifying, which is indistinguishable from forgery.
AUTHORITY_SIGNING_SEED=

# ─── Delivering verdicts to the interface ────────────────────────────
AUTHORITY_INTERFACE_URL=https://moderation.onym.app
# The enforcement backend's MODERATION_AUTHORITY_TOKEN.
AUTHORITY_INTERFACE_TOKEN=
# onym:key:<hex> of the interface's countersigning key — from its
# /health endpoint. Used to check that a registered mandate really was
# countersigned by the interface that claims to have witnessed it.
#
# Required in practice: with this blank, every mandate registration is
# refused, because an unverifiable designation is exactly the forgery
# the countersignature exists to catch. The service will run and
# acquire no jurisdiction at all.
AUTHORITY_INTERFACE_KEY=

# ─── Deciding cases ──────────────────────────────────────────────────
# Bearer token for POST /v1/cases/:id/decide. Deciding is this
# authority's judgment; unset, nothing can decide a case — though cases
# still resolve, by the decision-deadline default (dismissal).
# Generate with: openssl rand -hex 32
AUTHORITY_MODERATOR_TOKEN=

# How often to sweep for cases whose decision deadline has passed —
# and to retry triage and apply bans it deferred.
AUTHORITY_DEADLINE_SWEEP_SECS=300

# ─── Moderator panel ─────────────────────────────────────────────────
# Bearer token for the web panel at /admin, where appeals are reviewed.
# The panel displays evidence disclosed inside cases, so an unset token
# closes it — and with it, the only way a human reviews an appeal.
# Generate with: openssl rand -hex 32
AUTHORITY_ADMIN_TOKEN=

# ─── Automated triage ────────────────────────────────────────────────
# off        no classifier; every case waits for a human or the deadline
# advisory   classify and attach a recommendation; a human decides
# autonomous classify and decide; a human sees a case only on appeal
AUTHORITY_TRIAGE_MODE=off

# The model runs on THIS host. Case evidence is content a reporter
# disclosed for adjudication; sending it to someone else's API is a
# further disclosure your manifest's confidentiality policy would have
# to declare. The service logs an error at boot if this points off-box.
AUTHORITY_TRIAGE_URL=http://moderation-model:8000/v1/moderations
AUTHORITY_TRIAGE_MODEL=mistral-moderation-latest
# Only if your local server requires one. Not a Mistral cloud key.
AUTHORITY_TRIAGE_API_KEY=
# Image for the sibling model container (see docker-compose.yml).
AUTHORITY_TRIAGE_IMAGE=

# Score at/above which it recommends a ban, and at/below which it
# recommends dismissal. Between them it recommends nothing and the case
# waits for a human — widen that band when you trust the model less.
AUTHORITY_TRIAGE_BAN_THRESHOLD=0.9
AUTHORITY_TRIAGE_DISMISS_THRESHOLD=0.2

# JSON: violation class → the model categories that bear on it. The
# default covers the example manifest. This mapping is where a model's
# taxonomy is claimed to line up with terms a user consented to, so it
# belongs to whoever wrote the manifest.
# AUTHORITY_TRIAGE_CATEGORY_MAP={"csam":["sexual"],"credible-violence":["violence_and_threats"]}

RUST_LOG=info

# Copy to .env and fill in. Never commit .env.

# ─── Deployment ──────────────────────────────────────────────────────
DO_API_KEY=
AUTHORITY_HOST=authority.example.org
CADDY_EMAIL=you@example.org
DO_REGION=ams3
DO_DROPLET_SIZE=s-1vcpu-1gb
SSH_KEY_PATH=~/.ssh/id_ed25519

# Written back by deploy.sh; leave blank.
DROPLET_ID=
DROPLET_IP=

# ─── Identity ────────────────────────────────────────────────────────
# Ed25519 seed for the verdict-signing key: openssl rand -hex 32
#
# Two rules. The manifest's `operator` field must be the matching
# public key, or every verdict this authority issues will be refused
# downstream — the service refuses to start if they disagree.
# And never rotate this while any ban is in force: verdicts already
# issued would stop verifying, which is indistinguishable from forgery.
AUTHORITY_SIGNING_SEED=

# ─── Delivering verdicts to the interface ────────────────────────────
AUTHORITY_INTERFACE_URL=https://moderation.onym.app
# The enforcement backend's MODERATION_AUTHORITY_TOKEN.
AUTHORITY_INTERFACE_TOKEN=
# onym:key:<hex> of the interface's countersigning key — from its
# /health endpoint. Used to check that a registered mandate really was
# countersigned by the interface that claims to have witnessed it.
#
# Required in practice: with this blank, every mandate registration is
# refused, because an unverifiable designation is exactly the forgery
# the countersignature exists to catch. The service will run and
# acquire no jurisdiction at all.
AUTHORITY_INTERFACE_KEY=

# ─── Deciding cases ──────────────────────────────────────────────────
# Bearer token for POST /v1/cases/:id/decide. Deciding is this
# authority's judgment; unset, nothing can decide a case — though cases
# still resolve, by the decision-deadline default (dismissal).
# Generate with: openssl rand -hex 32
AUTHORITY_MODERATOR_TOKEN=

# How often to sweep for cases whose decision deadline has passed, and
# to assess cases whose response window has closed.
AUTHORITY_DEADLINE_SWEEP_SECS=300

# ─── Moderator panel ─────────────────────────────────────────────────
# Bearer token for the web panel at /admin, where appeals are reviewed.
# The panel displays evidence disclosed inside cases, so an unset token
# closes it — and with it, the only way a human reviews an appeal.
# Generate with: openssl rand -hex 32
AUTHORITY_ADMIN_TOKEN=

# ─── Automated assessment ────────────────────────────────────────────
# off        no classifier; every case waits for a human or the deadline
# advisory   classify and attach a recommendation; a human decides
# autonomous classify and decide; a human sees a case only on appeal
AUTHORITY_TRIAGE_MODE=off

# Which model decides. No default: this is a term users consent to, not
# something to inherit silently. One of the published profiles —
#
#   shieldstral-3b                  first-token score, 0.90 / 0.20
#   gpt-oss-safeguard-20b           binary 1 / 0
#   qwen3guard-8b                   native taxonomy
#   nemotron-3.5-content-safety-4b  "User Safety:" label
#   llama-guard-4-12b               native hazard codes
#   shieldgemma-9b                  first-token score, 0.90 / 0.20
#
# each matching a published document in ../authorities/.
AUTHORITY_TRIAGE_PROFILE=

# ...or your own, as JSON. Any model describable as a prompt template
# plus one of four output adapters works without a code change. Set one
# of these, never both: two profiles is two sets of terms.
AUTHORITY_TRIAGE_PROFILE_PATH=

# The inference endpoint — OpenAI-compatible chat completions, as
# llama.cpp, vLLM, Ollama and TGI all serve. The model runs on THIS
# host: case evidence is content a reporter disclosed for adjudication,
# and sending it to someone else's API is a further disclosure your
# manifest's confidentiality policy would have to declare. The service
# logs an error at boot if this points off-box.
#
# Score-based profiles also need the server to support `logprobs` and
# `top_logprobs`, or every case reaches no decision.
AUTHORITY_TRIAGE_URL=http://moderation-model:8000/v1/chat/completions

# What your inference server calls the loaded model, if it differs from
# the profile's default. The one triage value a deployment legitimately
# overrides — a served model name is nobody's consent.
AUTHORITY_TRIAGE_SERVED_MODEL=

# Only if your local server requires one. Not a hosted API key.
AUTHORITY_TRIAGE_API_KEY=

# Image for the sibling model container (see docker-compose.yml). Left
# blank because what can serve a given model locally depends on your
# licensing.
AUTHORITY_TRIAGE_IMAGE=

AUTHORITY_TRIAGE_TIMEOUT_SECS=120

# There is deliberately no threshold or category-map setting here.
# Those are published in the profile before consent — "consented
# policy, not mutable server configuration" — and an operator who could
# retune the ban threshold between two cases would be deciding the
# second under terms nobody agreed to.

RUST_LOG=info

# Copy to .env and fill in. Never commit .env or secrets/.

# ─── Deployment ──────────────────────────────────────────────────────
DO_API_KEY=
DOMAIN=onym.app
MODERATION_HOST=moderation.onym.app
CADDY_EMAIL=you@example.com
DO_REGION=ams3
DO_DROPLET_SIZE=s-1vcpu-1gb
SSH_KEY_PATH=~/.ssh/id_ed25519

# Written back by deploy.sh once the droplet exists; leave blank.
DROPLET_ID=
DROPLET_IP=

# ─── Interface identity ──────────────────────────────────────────────
# Ed25519 seed for the interface's countersigning key. Generate with:
#   openssl rand -hex 32
# Rotating this invalidates every countersignature already issued, so
# treat it as long-lived and back it up with the store.
MODERATION_INTERFACE_SIGNING_SEED=
MODERATION_INTERFACE_COMPONENT_ID=onym:component:onym-ios

# ─── Apple DeviceCheck ───────────────────────────────────────────────
# The .p8 goes at secrets/devicecheck.p8 (not here). These two come
# from the same page of the Apple developer portal as the key.
MODERATION_DEVICECHECK_KEY_ID=
MODERATION_DEVICECHECK_TEAM_ID=
# `development` accepts tokens from debug builds; a token minted in one
# environment is invalid in the other.
MODERATION_DEVICECHECK_ENV=production

# ─── Trust ───────────────────────────────────────────────────────────
# Reject verdicts whose authority signature does not verify. Defaults
# to false so a deployment can run before authorities publish signing
# keys. MUST be true in production — with it false, anyone who reaches
# the authority endpoint can ban a device.
MODERATION_ENFORCE_SIGNATURES=false

# Bearer token the designated authority presents on POST /v1/verdicts.
# Transport authentication only; the verdict signature is what
# authorizes a mark. REQUIRED: unset, the endpoint refuses everything.
# Generate with: openssl rand -hex 32
MODERATION_AUTHORITY_TOKEN=

# Deliberate opt-out from the line above. Only for a closed test
# deployment — with it true, anyone who reaches the host can submit
# verdicts.
MODERATION_ALLOW_UNAUTHENTICATED_AUTHORITY=false

# Bearer token for GET /v1/write-log, which names every device binding,
# verdict, and mark transition. Unset closes the endpoint.
MODERATION_AUDIT_TOKEN=

# Freshness window for signed session timestamps, seconds. Signatures
# are also single-use, so a captured body cannot be replayed at all.
MODERATION_SESSION_MAX_SKEW_SECS=300

RUST_LOG=info
